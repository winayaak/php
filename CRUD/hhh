    $name=$_POST['name'];
    $email=$_POST['email'];
    $age=$_POST['age'];
    $address=$_POST['address'];
    $sql=$conn->prepare("insert into emp(name,email,age,address)values(?,?,?,?)");
    $sql->bind_param('ssis',$name,$email,$age,$address);
    if($sql->execute()){
        echo " Record inserted successully";
    }
}

if(isset($_POST['update'])){

    $id=$_POST['id'];
    $name=$_POST['name'];
    $email=$_POST['email'];
    $age=$_POST['age'];
    $address=$_POST['address'];
    $sql=$conn->prepare("update emp set name=?,email=?,age=?,address=? where id=?");
    $sql->bind_param('ssisi',$name,$email,$age,$address,$id);
    if($sql->execute()){
        echo "Record updated successfully";
    }
}

if(isset($_POST['delete'])){

    $id=$_POST['id'];
    $sql=$conn->prepare("delete from emp where id=?");
    $sql->bind_param('i',$id);
    if ($sql->execute()) {
        echo " Record deleted"
    }
}

$result=$conn->query("select * from emp");

